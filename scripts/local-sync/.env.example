# Copy to .env and fill in — .env is gitignored.

aws_access_key_id=
aws_secret_access_key=

# Local folder where raw scorecard .txt files land
source_dir=/path/to/your/scorecards/folder

# S3 landing bucket (from `terraform output landing_bucket_name`)
s3_bucket=your-landing-bucket-name

# Optional key prefix within the bucket; leave blank for the bucket root
s3_prefix=
